{
  "name": "pulse-health-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run verify",
    "test:domains": "node --test tests/api-validation.test.mjs tests/calendar-domain.test.mjs tests/career-domain.test.mjs tests/health-domain.test.mjs tests/salary-domain.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "verify": "npm run build && npm run test:domains && npm run test:migrations && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-d1.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-d1.ps1",
    "db:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-d1-backup.ps1",
    "test:migrations": "node --test tests/migration-smoke.test.mjs"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
